# Database
DATABASE_URL="postgresql://user:password@localhost:5432/singscanner?schema=public"

# Auth (NextAuth v5)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Alpaca market data (leave empty to use mock)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_FEED="iex"

# Scanner config
SCANNER_HORIZON="5d"
SCANNER_UNIVERSE="auto"
SCANNER_MAX_SYMBOLS="300"
SCANNER_INTERVAL_S="15"
SCANNER_MOCK="false"
SCANNER_USE_XGBOOST="true"
SCANNER_USE_KRONOS="false"
KRONOS_PATH=""
