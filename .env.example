# Database
DATABASE_URL="postgresql://user:password@localhost:5432/singscanner?schema=public"

# Auth (NextAuth v5)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Alpaca market data (leave empty to use mock)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_FEED="iex"

# Scanner config
SCANNER_HORIZON="5d"
SCANNER_UNIVERSE="auto"
SCANNER_MAX_SYMBOLS="300"
SCANNER_INTERVAL_S="15"
SCANNER_MOCK="false"

# FMP API key — fallback fundamentals source when the Python sidecar is offline.
# Get one at https://financialmodelingprep.com/developer/docs
FMP_API_KEY=""

# Shadow monitor (A/B challenger against the baseline model)
SHADOW_ENABLED="true"

# Auto-trader (sub-project A). Master switch + one paper account per horizon.
TRADER_ENABLED=false
TRADER_ALPACA_PAPER_URL=https://paper-api.alpaca.markets
TRADER_3D_KEY_ID=
TRADER_3D_SECRET=
TRADER_5D_KEY_ID=
TRADER_5D_SECRET=
TRADER_10D_KEY_ID=
TRADER_10D_SECRET=
