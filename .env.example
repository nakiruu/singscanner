# ── Database (Postgres via Prisma) ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/singscanner?schema=public"

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that auto-upgrade to ADMIN on first login (case-insensitive).
# Existing accounts are NOT changed; promote those via the DB or /admin/users.
ADMIN_EMAILS=""

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="singscanner"
CLICKHOUSE_PASSWORD="changeme"
CLICKHOUSE_DB="singscanner"

# ── Alpaca market data ────────────────────────────────────────────────────────
# Leave blank to fall back to mock data.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# "iex" (free) or "sip" (paid subscription required)
ALPACA_FEED="iex"

# ── Fundamentals sidecar (Python) ─────────────────────────────────────────────
# URL of the running fundamentals microservice. Leave as default when using Docker.
FUNDAMENTALS_SIDECAR_URL="http://localhost:8000"
# HTTP timeout for sidecar calls (ms). Falls back to FMP_API_KEY on timeout.
FUNDAMENTALS_TIMEOUT_MS="5000"

# FMP API key — fallback fundamentals source when the Python sidecar is offline.
# Get one at https://financialmodelingprep.com/developer/docs
FMP_API_KEY=""

# ── Scanner ───────────────────────────────────────────────────────────────────
# Default trading horizon: 3d | 5d | 10d
SCANNER_HORIZON="5d"
# Same value exposed to the browser (must match SCANNER_HORIZON)
NEXT_PUBLIC_SCANNER_HORIZON="5d"
# "auto" uses the SP500 + NDX universe; or a comma-separated list of symbols
SCANNER_UNIVERSE="auto"
SCANNER_MAX_SYMBOLS="300"
# Seconds between full scans
SCANNER_INTERVAL_S="15"
# "true" to skip live Alpaca calls and use synthetic mock data
SCANNER_MOCK="false"

# ── Shadow monitor ────────────────────────────────────────────────────────────
# Master switch — set to "false" to disable the A/B challenger entirely
SHADOW_ENABLED="true"
# How many days of bar history to replay on cold start (default 200)
SHADOW_HISTORICAL_LOOKBACK_DAYS="200"
# Minimum resolved days before the challenger's posterior is trusted (default 100)
SHADOW_MIN_HISTORY_DAYS="100"
# Debounce window before flushing bucket aggregates to ClickHouse (ms, default 30000)
SHADOW_BUCKET_FLUSH_DEBOUNCE_MS="30000"
