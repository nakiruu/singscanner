# Copy to .env on the host (next to docker-compose.yml) and fill in secrets.
# This file is NOT committed.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=changeme

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Default values match docker-compose.yml — only override if you change them there.
CLICKHOUSE_PASSWORD=changeme

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL the app is served at (your NPM domain when live; localhost for local testing)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — leave blank to use credentials-only auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that auto-upgrade to ADMIN on first login (case-insensitive).
# Existing accounts are NOT changed; promote those via the DB or /admin/users.
ADMIN_EMAILS=

# ── Alpaca market data ────────────────────────────────────────────────────────
# Leave blank to use mock data (SCANNER_MOCK=true below)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "iex" (free) or "sip" (paid subscription required)
ALPACA_FEED=iex

# ── Scanner ───────────────────────────────────────────────────────────────────
# Default trading horizon: 3d | 5d | 10d
SCANNER_HORIZON=5d
SCANNER_UNIVERSE=auto
SCANNER_MAX_SYMBOLS=600
SCANNER_INTERVAL_S=15
# Set to "false" once you have real Alpaca credentials wired up
SCANNER_MOCK=true

# ── Fundamentals sidecar ──────────────────────────────────────────────────────
# Hardwired to the Docker service name in docker-compose.yml — no need to set.
# FUNDAMENTALS_SIDECAR_URL=http://fundamentals:8000
# FUNDAMENTALS_TIMEOUT_MS=5000

# FMP API key — fallback fundamentals source when the Python sidecar is offline.
FMP_API_KEY=

# ── Shadow monitor ────────────────────────────────────────────────────────────
SHADOW_ENABLED=true
# Uncomment to tune (shown with defaults):
# SHADOW_HISTORICAL_LOOKBACK_DAYS=200
# SHADOW_MIN_HISTORY_DAYS=100
# SHADOW_BUCKET_FLUSH_DEBOUNCE_MS=30000
