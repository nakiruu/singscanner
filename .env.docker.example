# Copy to .env on the Unraid host (next to docker-compose.yml) and edit.
# This file is NOT committed.

# Generate a strong Postgres password:
#   openssl rand -base64 24
POSTGRES_PASSWORD=changeme

# Generate a NextAuth secret:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL the app is served at (NPM domain when live; localhost for testing)
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bootstrap admins: comma-separated emails that auto-upgrade to ADMIN on register.
# Case-insensitive. Existing accounts are NOT changed; promote those via the DB.
ADMIN_EMAILS=

# Optional: Alpaca market data (leave blank to use mock data)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# Scanner config (overrides defaults in docker-compose.yml)
SCANNER_HORIZON=5d
SCANNER_UNIVERSE=auto
SCANNER_MAX_SYMBOLS=300
SCANNER_INTERVAL_S=15
SCANNER_MOCK=true
